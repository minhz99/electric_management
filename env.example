# ==============================================
# MQTT Configuration
# ==============================================
# Địa chỉ IP của MQTT Broker
MQTT_BROKER=

# Port của MQTT Broker (mặc định: 1883)
MQTT_PORT=

# Username cho MQTT (để trống nếu không cần xác thực)
MQTT_USER=

# Password cho MQTT (để trống nếu không cần xác thực)
MQTT_PASS=

# Danh sách topic MQTT để subscribe (phân cách bằng dấu phẩy)
MQTT_TOPICS=

# ==============================================
# Firebase Configuration
# ==============================================
# URL của Firebase Realtime Database
FIREBASE_DATABASE_URL=https://your-project-id.firebaseio.com/

# Đường dẫn tới file Service Account JSON tải từ Firebase Console
FIREBASE_CREDENTIALS_PATH=serviceAccountKey.json
